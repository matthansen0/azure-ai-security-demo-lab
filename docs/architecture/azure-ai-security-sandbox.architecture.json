    {
      "dot": "cyan",
      "title": "Protected Request + RAG",
      "items": [
        "Front Door WAF inspects public HTTPS; Detection is the sandbox default",
        "The RAG app sends embedding and completion calls through APIM",
        "AI Search returns cited chunks; Cosmos DB persists conversations"
      ]
    },
    {
      "dot": "rose",
      "title": "Identity + AI Controls",
      "items": [
        "APIM authenticates to Azure OpenAI with managed identity and retries 429/5xx responses",
        "Scoped RBAC protects model, search, storage, state, and agent access",
        "GPT-4o uses sandbox-content-safety filters for harmful content and prompt attacks"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence + Production Boundary",
      "items": [
        "Diagnostics feed Log Analytics; App Insights traces runtime behavior",
        "Defender plans are optional; core azd up leaves them disabled",
        "Production needs app auth, private networking, and multi-region design"
      ]
    }
